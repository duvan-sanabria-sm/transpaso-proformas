      <ui:InvokeCode ContinueOnError="{x:Null}" Code="' === OAuth 1.0a para NetSuite RESTlet (HMAC-SHA256) ===&#xD;&#xA;&#xD;&#xA;inConsumerKey = inConsumerKey.Trim()&#xD;&#xA;inConsumerSecret = inConsumerSecret.Trim()&#xD;&#xA;inToken = inToken.Trim()&#xD;&#xA;inTokenSecret = inTokenSecret.Trim()&#xD;&#xA;inRealm = inRealm.Trim()&#xD;&#xA;inUrl = inUrl.Trim()&#xD;&#xA;inMethod = inMethod.Trim().ToUpperInvariant()&#xD;&#xA;&#xD;&#xA;Dim epoch As New DateTime(1970,1,1,0,0,0, DateTimeKind.Utc)&#xD;&#xA;Dim ts As String = CLng((DateTime.UtcNow - epoch).TotalSeconds).ToString()&#xD;&#xA;Dim nonce As String = Guid.NewGuid().ToString(&quot;N&quot;)&#xD;&#xA;&#xD;&#xA;Dim enc As System.Func(Of String, String) =&#xD;&#xA;    Function(v As String)&#xD;&#xA;        Dim s = System.Uri.EscapeDataString(If(v, String.Empty))&#xD;&#xA;        ' RFC 3986 strict&#xD;&#xA;        s = s.Replace(&quot;!&quot;, &quot;%21&quot;).Replace(&quot;*&quot;, &quot;%2A&quot;).Replace(&quot;'&quot;, &quot;%27&quot;).Replace(&quot;(&quot;, &quot;%28&quot;).Replace(&quot;)&quot;, &quot;%29&quot;)&#xD;&#xA;        Return s&#xD;&#xA;    End Function&#xD;&#xA;&#xD;&#xA;' 1) Separar baseUrl y query params de inUrl&#xD;&#xA;Dim uri = New Uri(inUrl)&#xD;&#xA;Dim baseUrl As String = uri.GetLeftPart(UriPartial.Path)  ' SIN query&#xD;&#xA;Dim queryParams = New System.Collections.Generic.List(Of System.Collections.Generic.KeyValuePair(Of String, String))()&#xD;&#xA;&#xD;&#xA;If Not String.IsNullOrEmpty(uri.Query) Then&#xD;&#xA;    Dim raw = uri.Query.TrimStart(&quot;?&quot;c).Split(&quot;&amp;&quot;c)&#xD;&#xA;    For Each pair In raw&#xD;&#xA;        If String.IsNullOrEmpty(pair) Then Continue For&#xD;&#xA;        Dim kv = pair.Split(New Char() {&quot;=&quot;c}, 2)&#xD;&#xA;        Dim k = Uri.UnescapeDataString(kv(0))&#xD;&#xA;        Dim v = If(kv.Length &gt; 1, Uri.UnescapeDataString(kv(1)), &quot;&quot;)&#xD;&#xA;        queryParams.Add(New System.Collections.Generic.KeyValuePair(Of String, String)(k, v))&#xD;&#xA;    Next&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;' 2) Parámetros OAuth (no incluir realm en la firma)&#xD;&#xA;Dim allParams = New System.Collections.Generic.List(Of System.Collections.Generic.KeyValuePair(Of String, String))()&#xD;&#xA;allParams.Add(New System.Collections.Generic.KeyValuePair(Of String, String)(&quot;oauth_consumer_key&quot;, inConsumerKey))&#xD;&#xA;allParams.Add(New System.Collections.Generic.KeyValuePair(Of String, String)(&quot;oauth_nonce&quot;, nonce))&#xD;&#xA;allParams.Add(New System.Collections.Generic.KeyValuePair(Of String, String)(&quot;oauth_signature_method&quot;, &quot;HMAC-SHA256&quot;))&#xD;&#xA;allParams.Add(New System.Collections.Generic.KeyValuePair(Of String, String)(&quot;oauth_timestamp&quot;, ts))&#xD;&#xA;allParams.Add(New System.Collections.Generic.KeyValuePair(Of String, String)(&quot;oauth_token&quot;, inToken))&#xD;&#xA;allParams.Add(New System.Collections.Generic.KeyValuePair(Of String, String)(&quot;oauth_version&quot;, &quot;1.0&quot;))&#xD;&#xA;&#xD;&#xA;' 3) Incluir TODOS los query params (script, deploy, recordtype, etc.)&#xD;&#xA;allParams.AddRange(queryParams)&#xD;&#xA;&#xD;&#xA;' 4) Normalizar y ordenar (lexicográfico por key, luego value) -&gt; parameter string&#xD;&#xA;Dim ordered = allParams _&#xD;&#xA;    .OrderBy(Function(kv) kv.Key, StringComparer.Ordinal) _&#xD;&#xA;    .ThenBy(Function(kv) kv.Value, StringComparer.Ordinal) _&#xD;&#xA;    .ToList()&#xD;&#xA;&#xD;&#xA;Dim sb As New System.Text.StringBuilder()&#xD;&#xA;For i = 0 To ordered.Count - 1&#xD;&#xA;    If i &gt; 0 Then sb.Append(&quot;&amp;&quot;)&#xD;&#xA;    sb.Append(enc(ordered(i).Key)).Append(&quot;=&quot;).Append(enc(ordered(i).Value))&#xD;&#xA;Next&#xD;&#xA;Dim paramString As String = sb.ToString()&#xD;&#xA;&#xD;&#xA;' 5) Base string: METHOD &amp; baseUrl (sin query) &amp; parameter string (todo percent-encoded)&#xD;&#xA;Dim baseString As String = inMethod &amp; &quot;&amp;&quot; &amp; enc(baseUrl) &amp; &quot;&amp;&quot; &amp; enc(paramString)&#xD;&#xA;&#xD;&#xA;' 6) Firmar&#xD;&#xA;Dim signingKey As String = enc(inConsumerSecret) &amp; &quot;&amp;&quot; &amp; enc(inTokenSecret)&#xD;&#xA;Dim hmac = New System.Security.Cryptography.HMACSHA256(System.Text.Encoding.UTF8.GetBytes(signingKey))&#xD;&#xA;Dim signature As String = Convert.ToBase64String(hmac.ComputeHash(System.Text.Encoding.UTF8.GetBytes(baseString)))&#xD;&#xA;&#xD;&#xA;' 7) Authorization header (realm no se firma)&#xD;&#xA;Dim ah As New System.Text.StringBuilder(&quot;OAuth &quot;)&#xD;&#xA;ah.Append(&quot;realm=&quot;&quot;&quot;).Append(inRealm).Append(&quot;&quot;&quot;,&quot;)&#xD;&#xA;ah.Append(&quot;oauth_consumer_key=&quot;&quot;&quot;).Append(inConsumerKey).Append(&quot;&quot;&quot;,&quot;)&#xD;&#xA;ah.Append(&quot;oauth_token=&quot;&quot;&quot;).Append(inToken).Append(&quot;&quot;&quot;,&quot;)&#xD;&#xA;ah.Append(&quot;oauth_signature_method=&quot;&quot;HMAC-SHA256&quot;&quot;,&quot;)&#xD;&#xA;ah.Append(&quot;oauth_timestamp=&quot;&quot;&quot;).Append(ts).Append(&quot;&quot;&quot;,&quot;)&#xD;&#xA;ah.Append(&quot;oauth_nonce=&quot;&quot;&quot;).Append(nonce).Append(&quot;&quot;&quot;,&quot;)&#xD;&#xA;ah.Append(&quot;oauth_version=&quot;&quot;1.0&quot;&quot;,&quot;)&#xD;&#xA;ah.Append(&quot;oauth_signature=&quot;&quot;&quot;).Append(enc(signature)).Append(&quot;&quot;&quot;&quot;)&#xD;&#xA;&#xD;&#xA;outAuthHeader = ah.ToString()&#xD;&#xA;" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
