ot Nothing Then&#xA;            arr = ja&#xA;            Exit For&#xA;        End If&#xA;    Next&#xA;End If&#xA;&#xA;If arr Is Nothing Then&#xA;    ' Si no hay array en absoluto, tratar el objeto como una sola fila&#xA;    arr = New Newtonsoft.Json.Linq.JArray(innerObj)&#xA;End If&#xA;&#xA;' ------------------ JARRAY -&gt; DATATABLE ------------------&#xA;Dim dt As System.Data.DataTable&#xA;If arr IsNot Nothing AndAlso arr.Count &gt; 0 Then&#xA;    resultDt = Newtonsoft.Json.JsonConvert.DeserializeObject(Of System.Data.DataTable)(arr.ToString())&#xA;Else&#xA;    resultDt = New System.Data.DataTable()&#xA;End If" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
