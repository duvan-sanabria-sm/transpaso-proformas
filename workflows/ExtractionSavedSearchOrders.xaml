      <ui:InvokeCode ContinueOnError="{x:Null}" Code="' === OAuth 1.0a para NetSuite RESTlet (HMAC-SHA256) ===&#xA;&#xA;inConsumerKey = inConsumerKey.Trim()&#xA;inConsumerSecret = inConsumerSecret.Trim()&#xA;inToken = inToken.Trim()&#xA;inTokenSecret = inTokenSecret.Trim()&#xA;inRealm = inRealm.Trim()&#xA;inUrl = inUrl.Trim()&#xA;inMethod = inMethod.Trim().ToUpperInvariant()&#xA;&#xA;Dim epoch As New DateTime(1970,1,1,0,0,0, DateTimeKind.Utc)&#xA;Dim ts As String = CLng((DateTime.UtcNow - epoch).TotalSeconds).ToString()&#xA;Dim nonce As String = Guid.NewGuid().ToString(&quot;N&quot;)&#xA;&#xA;Dim enc As System.Func(Of String, String) =&#xA;    Function(v As String)&#xA;        Dim s = System.Uri.EscapeDataString(If(v, String.Empty))&#xA;        ' RFC 3986 strict&#xA;        s = s.Replace(&quot;!&quot;, &quot;%21&quot;).Replace(&quot;*&quot;, &quot;%2A&quot;).Replace(&quot;'&quot;, &quot;%27&quot;).Replace(&quot;(&quot;, &quot;%28&quot;).Replace(&quot;)&quot;, &quot;%29&quot;)&#xA;        Return s&#xA;    End Function&#xA;&#xA;' 1) Separar baseUrl y query params de inUrl&#xA;Dim uri = New Uri(inUrl)&#xA;Dim baseUrl As String = uri.GetLeftPart(UriPartial.Path)  ' SIN query&#xA;Dim queryParams = New System.Collections.Generic.List(Of System.Collections.Generic.KeyValuePair(Of String, String))()&#xA;&#xA;If Not String.IsNullOrEmpty(uri.Query) Then&#xA;    Dim raw = uri.Query.TrimStart(&quot;?&quot;c).Split(&quot;&amp;&quot;c)&#xA;    For Each pair In raw&#xA;        If String.IsNullOrEmpty(pair) Then Continue For&#xA;        Dim kv = pair.Split(New Char() {&quot;=&quot;c}, 2)&#xA;        Dim k = Uri.UnescapeDataString(kv(0))&#xA;        Dim v = If(kv.Length &gt; 1, Uri.UnescapeDataString(kv(1)), &quot;&quot;)&#xA;        queryParams.Add(New System.Collections.Generic.KeyValuePair(Of String, String)(k, v))&#xA;    Next&#xA;End If&#xA;&#xA;' 2) Parámetros OAuth (no incluir realm en la firma)&#xA;Dim allParams = New System.Collections.Generic.List(Of System.Collections.Generic.KeyValuePair(Of String, String))()&#xA;allParams.Add(New System.Collections.Generic.KeyValuePair(Of String, String)(&quot;oauth_consumer_key&quot;, inConsumerKey))&#xA;allParams.Add(New System.Collections.Generic.KeyValuePair(Of String, String)(&quot;oauth_nonce&quot;, nonce))&#xA;allParams.Add(New System.Collections.Generic.KeyValuePair(Of String, String)(&quot;oauth_signature_method&quot;, &quot;HMAC-SHA256&quot;))&#xA;allParams.Add(New System.Collections.Generic.KeyValuePair(Of String, String)(&quot;oauth_timestamp&quot;, ts))&#xA;allParams.Add(New System.Collections.Generic.KeyValuePair(Of String, String)(&quot;oauth_token&quot;, inToken))&#xA;allParams.Add(New System.Collections.Generic.KeyValuePair(Of String, String)(&quot;oauth_version&quot;, &quot;1.0&quot;))&#xA;&#xA;' 3) Incluir TODOS los query params (script, deploy, recordtype, etc.)&#xA;allParams.AddRange(queryParams)&#xA;&#xA;' 4) Normalizar y ordenar (lexicográfico por key, luego value) -&gt; parameter string&#xA;Dim ordered = allParams _&#xA;    .OrderBy(Function(kv) kv.Key, StringComparer.Ordinal) _&#xA;    .ThenBy(Function(kv) kv.Value, StringComparer.Ordinal) _&#xA;    .ToList()&#xA;&#xA;Dim sb As New System.Text.StringBuilder()&#xA;For i = 0 To ordered.Count - 1&#xA;    If i &gt; 0 Then sb.Append(&quot;&amp;&quot;)&#xA;    sb.Append(enc(ordered(i).Key)).Append(&quot;=&quot;).Append(enc(ordered(i).Value))&#xA;Next&#xA;Dim paramString As String = sb.ToString()&#xA;&#xA;' 5) Base string: METHOD &amp; baseUrl (sin query) &amp; parameter string (todo percent-encoded)&#xA;Dim baseString As String = inMethod &amp; &quot;&amp;&quot; &amp; enc(baseUrl) &amp; &quot;&amp;&quot; &amp; enc(paramString)&#xA;&#xA;' 6) Firmar&#xA;Dim signingKey As String = enc(inConsumerSecret) &amp; &quot;&amp;&quot; &amp; enc(inTokenSecret)&#xA;Dim hmac = New System.Security.Cryptography.HMACSHA256(System.Text.Encoding.UTF8.GetBytes(signingKey))&#xA;Dim signature As String = Convert.ToBase64String(hmac.ComputeHash(System.Text.Encoding.UTF8.GetBytes(baseString)))&#xA;&#xA;' 7) Authorization header (realm no se firma)&#xA;Dim ah As New System.Text.StringBuilder(&quot;OAuth &quot;)&#xA;ah.Append(&quot;realm=&quot;&quot;&quot;).Append(inRealm).Append(&quot;&quot;&quot;,&quot;)&#xA;ah.Append(&quot;oauth_consumer_key=&quot;&quot;&quot;).Append(inConsumerKey).Append(&quot;&quot;&quot;,&quot;)&#xA;ah.Append(&quot;oauth_token=&quot;&quot;&quot;).Append(inToken).Append(&quot;&quot;&quot;,&quot;)&#xA;ah.Append(&quot;oauth_signature_method=&quot;&quot;HMAC-SHA256&quot;&quot;,&quot;)&#xA;ah.Append(&quot;oauth_timestamp=&quot;&quot;&quot;).Append(ts).Append(&quot;&quot;&quot;,&quot;)&#xA;ah.Append(&quot;oauth_nonce=&quot;&quot;&quot;).Append(nonce).Append(&quot;&quot;&quot;,&quot;)&#xA;ah.Append(&quot;oauth_version=&quot;&quot;1.0&quot;&quot;,&quot;)&#xA;ah.Append(&quot;oauth_signature=&quot;&quot;&quot;).Append(enc(signature)).Append(&quot;&quot;&quot;&quot;)&#xA;&#xA;outAuthHeader = ah.ToString()&#xA;" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="450,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
